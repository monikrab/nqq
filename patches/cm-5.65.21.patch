-<!doctype html>
-
-<title>CodeMirror: Version 4 upgrade guide</title>
-<meta charset="utf-8"/>
-<link rel=stylesheet href="docs.css">
-<script src="activebookmark.js"></script>
-
-<div id=nav>
-  <a href="https://codemirror.net"><h1>CodeMirror</h1><img id=logo src="logo.png"></a>
-
